# 실제 값은 로컬 .env 에만. 이 파일(.env.example)엔 절대 넣지 말 것.
#
# 제공자는 "모델 문자열의 접두사"로 정해진다. 쓰는 제공자의 키만 채우면 되고,
# 갈아탈 때 고치는 건 이 파일뿐이다 — 호출 코드(model_router)는 안 바뀐다.

# ── 상용 LLM 키 (쓰는 것만 채우기) ──────────────────────────
# Google AI Studio — https://aistudio.google.com/apikey (카드 없이 무료 티어)
GEMINI_API_KEY=AIza-xxxxxxxx
# Groq — https://console.groq.com/keys (카드 불필요)
# 무료 한도(2026-08-25 공식 문서): gpt-oss 계열 30 RPM · 1,000 RPD · 8K TPM · 200K TPD.
# 🔴 실질 상한은 RPD 가 아니라 **TPD 200K** 다 — 요청당 3K 토큰이면 하루 60~80회다.
# GROQ_API_KEY=gsk_xxxxxxxx
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# OPENAI_API_KEY=sk-xxxxxxxx

# ── 티어별 모델 ─────────────────────────────────────────────
# 아래 조합은 2026-07-25 에 /ping 왕복 검증됨(무료 티어).
# 모델은 은퇴한다 — 404 "no longer available to new users" 가 나면 README 의 목록 조회로 갱신.
# 복합 추론용 (계획 생성·재계획)
COMPLEX_MODEL=gemini/gemini-3.6-flash
# 경량 작업용 (분류·요약) → W5+ 에서 로컬 Qwen으로 교체
LIGHT_MODEL=gemini/gemini-3.5-flash-lite

# Groq 로 갈아탈 때 (2026-08-25 확정 — Gemini 무료 한도 소진 대비)
# 🔴 REASONING_EFFORT 를 반드시 함께 바꿀 것. 아래 참조 — 안 바꾸면 매 호출이 거부된다.
# COMPLEX_MODEL=groq/openai/gpt-oss-120b
# LIGHT_MODEL=groq/openai/gpt-oss-20b

# 유료 제공자로 바꿀 때 예시 (키도 위에서 함께 바꿀 것)
# COMPLEX_MODEL=anthropic/claude-sonnet-5
# LIGHT_MODEL=anthropic/claude-haiku-4-5
# COMPLEX_MODEL=openai/gpt-5

# ── 로컬 LLM (W5+, 지금 미사용) ─────────────────────────────
# 로컬 전환 시: 아래 주석 해제 → 경량 티어가 자동으로 로컬로 라우팅됨(코드 무변경).
# LOCAL_MODEL=ollama/qwen3:8b
# OLLAMA_BASE_URL=http://localhost:11434

# ── 서비스 ─────────────────────────────────────────────────
PORT=8000
# 🔴 1024 로 두지 말 것. 상용 thinking 모델은 이 예산을 추론에 먼저 써서 /plans/draft 의 JSON 이
#    문자열 중간에서 잘리고 502 가 된다(2026-08-23 실측). /plans/replan 도 같은 이유로 출력이
#    char 2062 언저리에서 잘렸다(2026-08-24 관측 → 2026-08-25 원인이 이 값으로 규명됨).
#    코드 기본값은 이미 2048 인데 **이 예시 파일이 1024 로 덮어쓰고 있었다** — 예시가 결함을 배포했다.
MAX_TOKENS=2048

# 🔴 추론 강도. **제공자마다 받는 값이 다르다** — 틀린 값을 보내면 호출이 통째로 거부되는데,
#    Spring 은 그걸 "AI 없음" 으로 읽어 규칙 폴백한다. 화면은 멀쩡하고 AI 만 사라진다.
#      gemini/ … minimal   (2026-08-23 실측 채택: 20.4초 → 10.9초)
#      groq/   … low | medium | high   ← **minimal 은 무효**(2026-08-25 공식 문서)
#    확신이 없으면 비워 둘 것 — 비면 파라미터를 아예 안 붙인다.
REASONING_EFFORT=minimal
