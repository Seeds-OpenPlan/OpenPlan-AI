# 실제 값은 로컬 .env 에만. 이 파일(.env.example)엔 절대 넣지 말 것.

# ── 상용 LLM (Anthropic Claude) ─────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# 복합 추론용 (계획 생성·재계획). LiteLLM provider 프리픽스 사용.
COMPLEX_MODEL=anthropic/claude-sonnet-5
# 경량 작업용 (분류·요약). 지금은 상용 저가 → W5+ 에서 로컬 Qwen으로 교체.
LIGHT_MODEL=anthropic/claude-haiku-4-5

# ── 로컬 LLM (W5+, 지금 미사용) ─────────────────────────────
# 로컬 전환 시: 아래 주석 해제 → 경량 티어가 자동으로 로컬로 라우팅됨(코드 무변경).
# LOCAL_MODEL=ollama/qwen3:8b
# OLLAMA_BASE_URL=http://localhost:11434

# ── 서비스 ─────────────────────────────────────────────────
PORT=8000
MAX_TOKENS=1024
