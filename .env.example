# 실제 값은 로컬 .env 에만. 이 파일(.env.example)엔 절대 넣지 말 것.
#
# 제공자는 "모델 문자열의 접두사"로 정해진다. 쓰는 제공자의 키만 채우면 되고,
# 갈아탈 때 고치는 건 이 파일뿐이다 — 호출 코드(model_router)는 안 바뀐다.

# ── 상용 LLM 키 (쓰는 것만 채우기) ──────────────────────────
# Google AI Studio — https://aistudio.google.com/apikey (카드 없이 무료 티어)
GEMINI_API_KEY=AIza-xxxxxxxx
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# OPENAI_API_KEY=sk-xxxxxxxx

# ── 티어별 모델 ─────────────────────────────────────────────
# 아래 조합은 2026-07-25 에 /ping 왕복 검증됨(무료 티어).
# 모델은 은퇴한다 — 404 "no longer available to new users" 가 나면 README 의 목록 조회로 갱신.
# 복합 추론용 (계획 생성·재계획)
COMPLEX_MODEL=gemini/gemini-3.6-flash
# 경량 작업용 (분류·요약) → W5+ 에서 로컬 Qwen으로 교체
LIGHT_MODEL=gemini/gemini-3.5-flash-lite

# 유료 제공자로 바꿀 때 예시 (키도 위에서 함께 바꿀 것)
# COMPLEX_MODEL=anthropic/claude-sonnet-5
# LIGHT_MODEL=anthropic/claude-haiku-4-5
# COMPLEX_MODEL=openai/gpt-5

# ── 로컬 LLM (W5+, 지금 미사용) ─────────────────────────────
# 로컬 전환 시: 아래 주석 해제 → 경량 티어가 자동으로 로컬로 라우팅됨(코드 무변경).
# LOCAL_MODEL=ollama/qwen3:8b
# OLLAMA_BASE_URL=http://localhost:11434

# ── 서비스 ─────────────────────────────────────────────────
PORT=8000
MAX_TOKENS=1024
